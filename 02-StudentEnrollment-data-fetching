-- fetching data with ranking functions with partition
SELECT std_name, department, marks, 
    RANK() OVER (
        ORDER BY marks DESC) AS Rank 
FROM student;

SELECT std_name, department, marks, 
    RANK() OVER(
        PARTITION BY department
        ORDER BY marks DESC
    ) AS department_rank 
FROM student;