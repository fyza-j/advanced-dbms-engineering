-- fetch data with ranking functions
SELECT std_name, department, marks, 
    ROW_NUMBER() OVER (
        ORDER BY marks DESC) AS RowNum 
FROM student;

SELECT std_name, department, marks, 
    RANK() OVER (
        ORDER BY marks DESC) AS Rank 
FROM student;

UPDATE student SET marks = 97 where student_id = 246;

SELECT std_name, department, marks, 
    RANK() OVER (
        ORDER BY marks DESC) AS Rank 
FROM student;

