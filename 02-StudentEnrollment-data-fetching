-- create student table
CREATE TABLE student (
  student_id INTEGER PRIMARY KEY,
  std_name TEXT NOT NULL,
  department TEXT NOT NULL,
  semester INTEGER NOT NULL,
  marks INTEGER NOT NULL
);

